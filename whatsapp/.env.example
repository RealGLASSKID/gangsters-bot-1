# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Auth ---
# Comma-separated list of API keys this relay accepts on incoming requests
# (Authorization: Bearer <key>). Callers = your backend / admin tools.
RELAY_API_KEYS=change-me-to-a-long-random-string

# --- Rate limiting (optional; disabled if Redis is unset) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=900

# --- WhatsApp session ---
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Country code (no +) used to normalize local-format numbers (leading 0)
# that occasionally show up on @lid inbound payloads. Set '' to disable.
WHATSAPP_DEFAULT_COUNTRY_CODE=234
# Optional: path to a system Chromium binary (recommended in Docker)
PUPPETEER_EXECUTABLE_PATH=

# --- Backend ("the brain") ---
# Base URL of the service that owns business logic — gangster-bot-brain
# (Express + SQLite), not the Next.js dashboard directly.
BACKEND_URL=http://localhost:3001
# Path appended to BACKEND_URL for inbound WhatsApp messages.
BACKEND_INBOUND_PATH=/api/whatsapp/inbound
# Shared secret sent as `x-webhook-secret` header; verify this in your backend.
BACKEND_WEBHOOK_SECRET=change-me-to-a-long-random-string
